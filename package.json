{
  "name": "vlm_screenshot_action",
  "private": true,
  "version": "0.1.1",
  "description": "A Windows reference implementation of a screenshot-driven visual model control loop",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/s11IM/VLM_Screenshot_Action.git"
  },
  "bugs": {
    "url": "https://github.com/s11IM/VLM_Screenshot_Action/issues"
  },
  "homepage": "https://github.com/s11IM/VLM_Screenshot_Action#readme",
  "engines": {
    "node": "^24.12.0"
  },
  "type": "module",
  "scripts": {
    "cleanup:cache": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/cleanup-cache.ps1",
    "cleanup:migration": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/cleanup-cache.ps1 -ForMigration",
    "package:migration": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/package-portable.ps1 -ArchiveOnly",
    "package:public": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/package-portable.ps1 -PublicRelease -ArchiveOnly",
    "test": "node --test src/__tests__/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "test:rust": "cargo test --locked --manifest-path desktop-core/Cargo.toml && cargo test --locked --manifest-path src-tauri/Cargo.toml",
    "fmt:rust": "cargo fmt --manifest-path desktop-core/Cargo.toml && cargo fmt --manifest-path src-tauri/Cargo.toml",
    "fmt:rust:check": "cargo fmt --manifest-path desktop-core/Cargo.toml -- --check && cargo fmt --manifest-path src-tauri/Cargo.toml -- --check",
    "predev": "npm run cleanup:cache",
    "dev": "vite",
    "prebuild": "npm run cleanup:cache",
    "build": "tsc && vite build",
    "prepreview": "npm run cleanup:cache",
    "preview": "vite preview",
    "pretauri": "npm run cleanup:cache",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "lucide-react": "^0.468.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0"
  }
}
