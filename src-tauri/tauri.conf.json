{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VLM_Screenshot_Action",
  "version": "0.1.1",
  "identifier": "com.vlmscreenshotaction.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "VLM_Screenshot_Action",
        "width": 1360,
        "height": 820,
        "minWidth": 1024,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["main-capability"]
    }
  },
  "bundle": {
    "active": true,
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "targets": ["nsis", "msi"],
    "icon": []
  }
}
